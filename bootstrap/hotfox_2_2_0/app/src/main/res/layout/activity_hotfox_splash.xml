<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.18" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <ImageView
            android:id="@+id/img_planet_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_native_planet_backdrop" />

        <ImageView
            android:id="@+id/img_splash_fox"
            android:layout_width="match_parent"
            android:layout_height="232dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_fox_bust_transparent" />
    </FrameLayout>

    <ImageView
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/hotfox_wordmark_cd"
        android:scaleType="fitCenter"
        android:src="@drawable/hf_brand_wordmark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.12"
        android:text="@string/hotfox_tagline_more_than_vpn"
        android:textColor="@color/hf_asset_muted"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="4dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/hf_loading_track" />

        <ImageView
            android:id="@+id/img_splash_fill"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/hf_loading_fill" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.28" />
</LinearLayout>
