<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="HotFox"
                    android:textColor="@color/hotfox_orange"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_header_microcopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/hotfox_header_microcopy_connection"
                    android:textColor="@color/hotfox_editorial_text_dim"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/support_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="@string/hotfox_add_subscription"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="9dp"
                    android:text=""
                    android:visibility="gone"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_hotfox_line_search"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/hotfox_editorial_text" />

                <ImageView
                    android:id="@+id/btn_header_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/hotfox_row_ripple"
                    android:clickable="true"
                    android:contentDescription="@string/hotfox_nav_settings"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_hotfox_line_settings" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/hotfox_orange"
            app:trackColor="@android:color/transparent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/screen_connection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:id="@+id/hero_surface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp">

                        <ImageView
                            android:id="@+id/brand_logo"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/connect_halo"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone">

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/fab"
                                android:layout_width="1dp"
                                android:layout_height="1dp"
                                android:visibility="gone"
                                android:src="@drawable/ic_hotfox_power_36"
                                app:tint="@color/hotfox_editorial_text" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/status_block"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp">

                            <TextView
                                android:id="@+id/tv_connect_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="-0.02"
                                android:text="@string/hotfox_headline_disconnected"
                                android:textColor="@color/hotfox_cream"
                                android:textSize="32sp" />

                            <TextView
                                android:id="@+id/tv_connect_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/hotfox_subtitle_disconnected"
                                android:textColor="@color/hotfox_cream_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_vpn_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="00:00:00"
                                android:textColor="@color/hotfox_cream"
                                android:textSize="18sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_routing_inline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Умная маршрутизация · Auto"
                                android:textColor="@color/hotfox_editorial_text_dim"
                                android:textSize="10sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="168dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/iv_connection_artwork"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hotfox_art_fox_planet_home" />

                        <ImageView
                            android:id="@+id/iv_connecting_ring"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/hotfox_connecting_ring"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cta_slot_mid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <FrameLayout
                            android:id="@+id/connect_cta_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/hotfox_cta_height">

                            <TextView
                                android:id="@+id/connect_action"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/hotfox_connect_action_bg"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="22dp"
                                android:paddingEnd="44dp"
                                android:text="@string/hotfox_connect"
                                android:textColor="@color/hotfox_cta_on_orange"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/iv_cta_arrow"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="22dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_hotfox_cta_arrow" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/traffic_block"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_traffic_down" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                            <TextView android:id="@+id/tv_downloaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="↓ 0 MB" android:textColor="@color/hotfox_editorial_text" android:textSize="20sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_traffic_up" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                            <TextView android:id="@+id/tv_uploaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="↑ 0 MB" android:textColor="@color/hotfox_editorial_text" android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/connecting_stages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/tv_stage_select" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/hotfox_stage_select" android:textColor="@color/hotfox_cream_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_stage_connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/hotfox_stage_connect" android:textColor="@color/hotfox_cream_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_stage_verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/hotfox_stage_verify" android:textColor="@color/hotfox_cream_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_stage_rules" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/hotfox_stage_rules" android:textColor="@color/hotfox_cream_muted" android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/connecting_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/hotfox_orange"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/connection_rows_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/hotfox_rows_card"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp">

                    <LinearLayout
                        android:id="@+id/selected_server_card"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hotfox_row_height"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_hotfox_line_server" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tv_server_row_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_row_server" android:textColor="@color/hotfox_cream" android:textSize="15sp" />
                            <TextView android:id="@+id/tv_auto_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_auto_server" android:textColor="@color/hotfox_cream_muted" android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_selected_server"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="120dp"
                            android:maxLines="1"
                            android:text="@string/hotfox_server_not_selected"
                            android:textColor="@color/hotfox_cream_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_selected_server_hint"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:text="@string/hotfox_choose_location" />

                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_subscription_quick"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hotfox_row_height"
                        android:background="@drawable/hotfox_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/hotfox_row_subscription"
                            android:src="@drawable/ic_hotfox_line_crown" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_row_subscription" android:textColor="@color/hotfox_cream" android:textSize="15sp" />
                            <TextView android:id="@+id/tv_subscription_quick" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/hotfox_cream_muted" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_shadow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hotfox_row_height"
                        android:background="@drawable/hotfox_row_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_shadow"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/hotfox_row_shadow"
                            android:src="@drawable/ic_hotfox_line_shield" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_row_shadow" android:textColor="@color/hotfox_cream" android:textSize="15sp" />
                            <TextView android:id="@+id/tv_shadow_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/hotfox_cream_muted" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/smart_routing_card"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hotfox_row_height"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/smart_routing_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/hotfox_smart_routing"
                            android:src="@drawable/ic_hotfox_line_route" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tv_smart_routing_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_row_routing" android:textColor="@color/hotfox_cream" android:textSize="15sp" />
                            <TextView android:id="@+id/tv_smart_routing_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/hotfox_route_smart_summary" android:textColor="@color/hotfox_cream_muted" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
                    </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/info_surface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/hotfox_info_surface"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tv_info_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hotfox_info_not_protected"
                            android:textColor="@color/hotfox_cream"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.v2ray.ang.vpn.HotfoxRouteBarsView
                        android:id="@+id/route_bars"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/route_labels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hotfox_route_you" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/hotfox_route_vpn" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/hotfox_route_internet" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_connection_stage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/hotfox_editorial_text_dim"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_subscription_snapshot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/hotfox_editorial_text_dim"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/cta_slot_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/screen_servers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/hotfox_servers_heading"
                    android:textColor="@color/hotfox_cream"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hotfox_servers_body"
                    android:textColor="@color/hotfox_cream_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="0dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:id="@+id/filter_all" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Все" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                    <TextView android:id="@+id/filter_favorites" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.35" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Избранные" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="12sp" />
                    <TextView android:id="@+id/filter_countries" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Страны" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="12sp" />
                    <LinearLayout android:id="@+id/layout_test" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center">
                        <TextView android:id="@+id/tv_test_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Пинг" android:textColor="@color/hotfox_orange" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_group"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/hotfox_orange"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="1dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabTextColor="@color/hotfox_editorial_text_secondary"
                    app:tabSelectedTextColor="@color/hotfox_editorial_text" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/screen_subscription"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:id="@+id/layout_premium_onboarding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:text="@string/hotfox_premium_title"
                            android:textColor="@color/hotfox_editorial_text"
                            android:textSize="43sp" />
                        <TextView
                            android:id="@+id/tv_premium_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/hotfox_editorial_text_dim"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/hotfox_premium_benefits"
                            android:textColor="@color/hotfox_editorial_text_dim"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/layout_plan_catalog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tv_plan_catalog_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/hotfox_plan_catalog_unavailable"
                            android:textColor="@color/hotfox_editorial_text_dim"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/action_premium_buy"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/hotfox_connect_action_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/hotfox_buy"
                            android:textColor="@color/hotfox_editorial_text"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/action_already_subscribed"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/hotfox_already_have_subscription"
                            android:textColor="@color/hotfox_editorial_text"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/action_restore_access"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/hotfox_restore_access"
                            android:textColor="@color/hotfox_editorial_text_secondary"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/action_enter_promo"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/hotfox_enter_promo"
                            android:textColor="@color/hotfox_editorial_text_dim"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/hotfox_checkout_external_note"
                            android:textColor="@color/hotfox_editorial_text_dim"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_subscription_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/hotfox_subscription_heading" android:textColor="@color/hotfox_cream" android:textSize="32sp" />
                    <TextView android:id="@+id/tv_subscription_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/hotfox_sub_status_unknown" android:textColor="@color/hotfox_cream_muted" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Больше свободы.\nБольше интернета для тебя." android:textColor="@color/hotfox_editorial_text_dim" android:textSize="13sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="34dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_sub_valid_until" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                            <TextView android:id="@+id/tv_subscription_expire" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="serif" android:text="—" android:textColor="@color/hotfox_editorial_text" android:textSize="28sp" />
                            <TextView android:id="@+id/tv_subscription_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/hotfox_expiry_unknown" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="72dp" android:background="@color/hotfox_editorial_line" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.65" android:gravity="end" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_sub_servers" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                            <TextView android:id="@+id/tv_subscription_servers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/hotfox_editorial_text" android:textSize="34sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_sub_locations" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:id="@+id/tv_subscription_traffic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/hotfox_traffic_unknown" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="44dp" android:text="@string/hotfox_sub_url_label" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                    <TextView android:id="@+id/tv_subscription_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:ellipsize="middle" android:maxLines="1" android:text="—" android:textColor="@color/hotfox_editorial_text" android:textIsSelectable="true" android:textSize="11sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/hotfox_editorial_line" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="46dp" android:orientation="horizontal">
                        <TextView android:id="@+id/action_subscription_update" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:minHeight="48dp" android:text="@string/hotfox_sub_update" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                        <View android:layout_width="1dp" android:layout_height="28dp" android:layout_gravity="center_vertical" android:background="@color/hotfox_editorial_line" />
                        <TextView android:id="@+id/action_subscription_import" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:clickable="true" android:focusable="true" android:gravity="center" android:minHeight="48dp" android:text="@string/hotfox_sub_import" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                        <View android:layout_width="1dp" android:layout_height="28dp" android:layout_gravity="center_vertical" android:background="@color/hotfox_editorial_line" />
                        <TextView android:id="@+id/action_subscription_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:minHeight="48dp" android:text="@string/hotfox_sub_add" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/hotfox_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotfox_bottom_nav_height"
            android:background="@color/hotfox_bg_main"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/nav_connection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/hotfox_nav_home"
                android:drawableTop="@drawable/ic_hotfox_line_home"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="@string/hotfox_nav_home"
                android:textColor="@color/hotfox_orange"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nav_servers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/hotfox_nav_servers"
                android:drawableTop="@drawable/ic_hotfox_line_server"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="@string/hotfox_nav_servers"
                android:textColor="@color/hotfox_cream_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nav_subscription"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/hotfox_nav_subscription"
                android:drawableTop="@drawable/ic_hotfox_line_crown"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="@string/hotfox_nav_subscription"
                android:textColor="@color/hotfox_cream_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/hotfox_nav_settings"
                android:drawableTop="@drawable/ic_hotfox_line_settings"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="@string/hotfox_nav_settings"
                android:textColor="@color/hotfox_cream_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:menu="@menu/menu_hotfox_bottom" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
