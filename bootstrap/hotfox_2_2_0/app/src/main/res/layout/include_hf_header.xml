<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hf_header"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <ImageButton
        android:id="@+id/btn_header_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hotfox_back"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/hf_arrow_left_orange"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_wordmark"
        android:layout_width="88dp"
        android:layout_height="24dp"
        android:contentDescription="@string/hotfox_wordmark_cd"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/hf_brand_wordmark" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btn_header_search"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hotfox_search"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/hf_search_cream"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_header_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hotfox_nav_settings"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/hf_settings_cream"
        android:visibility="gone" />
</LinearLayout>
