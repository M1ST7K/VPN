<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <include layout="@layout/include_hotfox_sub_header" />

    <TextView
        android:id="@+id/tv_https_kicker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_https_title"
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_https_title" />

    <TextView
        android:id="@+id/tv_https_body"
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/hotfox_https_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/hotfox_rows_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_hotfox_line_link" />

        <EditText
            android:id="@+id/et_https_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hotfox_https_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/hotfox_cream"
            android:textColorHint="@color/hotfox_cream_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_https_paste"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/hotfox_https_paste"
            android:textColor="@color/hotfox_orange"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_https_privacy"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_hotfox_line_lock"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="@string/hotfox_https_privacy" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_cta_height"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/btn_https_add"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="44dp"
            android:text="@string/hotfox_https_add" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="22dp"
            android:src="@drawable/ic_hotfox_cta_arrow" />
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/hotfox_art_fox_planet_https" />
</LinearLayout>
