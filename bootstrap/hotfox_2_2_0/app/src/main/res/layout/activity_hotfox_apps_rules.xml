<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <include layout="@layout/include_hotfox_sub_header" />

    <TextView
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_apps_rules_title" />

    <TextView
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_apps_rules_body" />

    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_apps_open"
        style="@style/HotFoxCtaPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_cta_height"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/hotfox_apps_open_list" />
</LinearLayout>
