<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/hotfox_screen_inset"
        android:paddingBottom="28dp">

        <TextView
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hotfox_settings_title"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/settings_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
