<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <include layout="@layout/include_hotfox_sub_header" />

    <TextView
        android:id="@+id/tv_routing_title"
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_routing_screen_title" />

    <TextView
        android:id="@+id/tv_routing_summary"
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_routing_screen_summary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hotfox_rows_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/row_routing_mode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_route" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tv_routing_mode" style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_route_smart" />
                    <TextView android:id="@+id/tv_routing_mode_detail" style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_route_smart_summary" />
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_routing_apps"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_apps" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_apps" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_apps_hint" />
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_routing_dns"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_globe" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tv_routing_dns" style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_dns" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_dns_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_routing_dns_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_routing_lan"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_route" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tv_routing_lan" style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_lan" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_lan_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_routing_lan_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_routing_ipv6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <TextView android:id="@+id/tv_routing_ipv6" style="@style/HotFoxTextHeadline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hotfox_routing_ipv6" />
                <TextView android:id="@+id/tv_routing_ipv6_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_routing_advanced"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <TextView style="@style/HotFoxTextHeadline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hotfox_routing_custom" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_routing_reconnect"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_refresh" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_reconnect" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_routing_reconnect_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_routing_reconnect_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_cta_height"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/btn_routing_mode"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="44dp"
            android:text="@string/hotfox_routing_apply" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="22dp" android:src="@drawable/ic_hotfox_cta_arrow" />
    </FrameLayout>
</LinearLayout>
