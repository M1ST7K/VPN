<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_editorial_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="horizontal">

        <!-- Persistent editorial rail: the three app sections from the approved reference. -->
        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:background="@color/hotfox_editorial_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="74dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:id="@+id/rail_connection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/dot_connection"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/hotfox_dot_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.17"
                    android:rotation="-90"
                    android:text="СОЕДИНЕНИЕ"
                    android:textColor="@color/hotfox_editorial_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="44dp"
                android:background="@color/hotfox_editorial_line" />

            <LinearLayout
                android:id="@+id/rail_servers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/dot_servers"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/hotfox_dot_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="31dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.17"
                    android:rotation="-90"
                    android:text="СЕРВЕРЫ"
                    android:textColor="@color/hotfox_editorial_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="44dp"
                android:background="@color/hotfox_editorial_line" />

            <LinearLayout
                android:id="@+id/rail_subscription"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/dot_subscription"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/hotfox_dot_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.17"
                    android:rotation="-90"
                    android:text="ПОДПИСКА"
                    android:textColor="@color/hotfox_editorial_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@android:color/transparent"
                android:paddingStart="6dp"
                android:paddingEnd="18dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="HotFox"
                        android:textColor="@color/hotfox_editorial_text"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:lineSpacingExtra="1dp"
                        android:text="Proxy for\na freer internet"
                        android:textColor="@color/hotfox_editorial_text_dim"
                        android:textSize="9sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/support_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@string/hotfox_add_subscription"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:padding="9dp"
                        android:text=""
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_add_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/hotfox_editorial_text_secondary" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorColor="@color/hotfox_orange"
                app:trackColor="@android:color/transparent" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- CONNECTION -->
                <ScrollView
                    android:id="@+id/screen_connection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="620dp"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="18dp">

                        <FrameLayout
                            android:id="@+id/hero_surface"
                            android:layout_width="match_parent"
                            android:layout_height="106dp">

                            <ImageView
                                android:id="@+id/brand_logo"
                                android:layout_width="1dp"
                                android:layout_height="1dp"
                                android:visibility="gone" />

                            <FrameLayout
                                android:id="@+id/connect_halo"
                                android:layout_width="1dp"
                                android:layout_height="1dp"
                                android:visibility="gone">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/fab"
                                    android:layout_width="1dp"
                                    android:layout_height="1dp"
                                    android:visibility="gone"
                                    android:src="@drawable/ic_hotfox_power_36" />
                            </FrameLayout>

                            <LinearLayout
                                android:id="@+id/status_block"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_connect_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-light"
                                    android:letterSpacing="-0.03"
                                    android:text="Готово"
                                    android:textColor="@color/hotfox_editorial_text"
                                    android:textSize="45sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_vpn_status"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="sans-serif"
                                        android:text="00:00:00"
                                        android:textColor="@color/hotfox_editorial_text"
                                        android:textSize="15sp" />

                                    <TextView
                                        android:id="@+id/tv_routing_inline"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Умная маршрутизация · Auto"
                                        android:textColor="@color/hotfox_editorial_text_dim"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/selected_server_card"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_marginTop="18dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tv_selected_server"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:fontFamily="sans-serif"
                                        android:maxLines="1"
                                        android:text="@string/hotfox_server_not_selected"
                                        android:textColor="@color/hotfox_editorial_text"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:id="@+id/tv_selected_server_hint"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="@string/hotfox_choose_location"
                                        android:textColor="@color/hotfox_editorial_text_dim"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/hotfox_editorial_line"
                                    android:textSize="20sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View android:layout_width="2dp" android:layout_height="42dp" android:background="@color/hotfox_editorial_text_secondary" />
                            <View android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@color/hotfox_editorial_line" />
                            <View android:layout_width="3dp" android:layout_height="66dp" android:background="@color/hotfox_orange" />
                            <View android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@color/hotfox_editorial_line" />
                            <View android:layout_width="2dp" android:layout_height="42dp" android:background="@color/hotfox_editorial_text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Вы" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="VPN" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Интернет" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/smart_routing_card"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="18dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/smart_routing_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@string/hotfox_smart_routing"
                                    android:src="@drawable/ic_hotfox_smart_route_24"
                                    app:tint="@color/hotfox_orange" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:id="@+id/tv_smart_routing_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_route_smart" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                                    <TextView android:id="@+id/tv_smart_routing_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/hotfox_route_smart_summary" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="9sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Загружено" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                                <TextView android:id="@+id/tv_downloaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="↓ 0 MB" android:textColor="@color/hotfox_editorial_text" android:textSize="18sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Отправлено" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                                <TextView android:id="@+id/tv_uploaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="↑ 0 MB" android:textColor="@color/hotfox_editorial_text" android:textSize="18sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/connect_action"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="30dp"
                            android:background="@drawable/hotfox_connect_action_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="140dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Подключить"
                            android:textColor="@color/hotfox_editorial_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </ScrollView>

                <!-- SERVERS -->
                <LinearLayout
                    android:id="@+id/screen_servers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:text="Серверы"
                        android:textColor="@color/hotfox_editorial_text"
                        android:textSize="43sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Выбирай направление.\nМы оптимизируем остальное."
                        android:textColor="@color/hotfox_editorial_text_dim"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/filter_all" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Все" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                        <TextView android:id="@+id/filter_favorites" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.35" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Избранные" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="12sp" />
                        <TextView android:id="@+id/filter_countries" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Страны" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="12sp" />
                        <LinearLayout android:id="@+id/layout_test" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center">
                            <TextView android:id="@+id/tv_test_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Пинг" android:textColor="@color/hotfox_orange" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_group"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/hotfox_orange"
                        app:tabIndicatorFullWidth="false"
                        app:tabIndicatorHeight="1dp"
                        app:tabMode="fixed"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabTextColor="@color/hotfox_editorial_text_secondary"
                        app:tabSelectedTextColor="@color/hotfox_editorial_text" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- SUBSCRIPTION -->
                <ScrollView
                    android:id="@+id/screen_subscription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="620dp"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="20dp">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-light" android:text="Premium" android:textColor="@color/hotfox_editorial_text" android:textSize="43sp" />
                        <TextView android:id="@+id/tv_subscription_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="● Активна" android:textColor="@color/hotfox_success_bright" android:textSize="15sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Больше свободы.\nБольше интернета для тебя." android:textColor="@color/hotfox_editorial_text_dim" android:textSize="13sp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="34dp" android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Действует до" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                                <TextView android:id="@+id/tv_subscription_expire" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="serif" android:text="—" android:textColor="@color/hotfox_editorial_text" android:textSize="23sp" />
                                <TextView android:id="@+id/tv_subscription_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Срок не указан" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="11sp" />
                            </LinearLayout>
                            <View android:layout_width="1dp" android:layout_height="72dp" android:background="@color/hotfox_editorial_line" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.65" android:gravity="end" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Серверов" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                                <TextView android:id="@+id/tv_subscription_servers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/hotfox_editorial_text" android:textSize="34sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="локации" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView android:id="@+id/tv_subscription_traffic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/hotfox_traffic_unknown" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="44dp" android:text="URL подписки" android:textColor="@color/hotfox_editorial_text_dim" android:textSize="10sp" />
                        <TextView android:id="@+id/tv_subscription_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:ellipsize="middle" android:maxLines="1" android:text="—" android:textColor="@color/hotfox_editorial_text" android:textIsSelectable="true" android:textSize="11sp" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/hotfox_editorial_line" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="46dp" android:orientation="horizontal">
                            <TextView android:id="@+id/action_subscription_update" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Обновить" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                            <View android:layout_width="1dp" android:layout_height="28dp" android:layout_gravity="center_vertical" android:background="@color/hotfox_editorial_line" />
                            <TextView android:id="@+id/action_subscription_import" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Импортировать" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                            <View android:layout_width="1dp" android:layout_height="28dp" android:layout_gravity="center_vertical" android:background="@color/hotfox_editorial_line" />
                            <TextView android:id="@+id/action_subscription_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Добавить" android:textColor="@color/hotfox_editorial_text" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                app:menu="@menu/menu_hotfox_bottom" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
