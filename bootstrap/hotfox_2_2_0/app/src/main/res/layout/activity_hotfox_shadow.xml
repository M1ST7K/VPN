<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tv_shadow_kicker"
        style="@style/HotFoxTextBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hotfox_shadow_title" />

    <TextView
        android:id="@+id/tv_shadow_title"
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/hotfox_shadow_title"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tv_shadow_body"
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_shadow_body" />

    <TextView
        android:id="@+id/tv_shadow_status"
        style="@style/HotFoxTextHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_shadow_mode"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/hotfox_shadow_mode" />

    <ImageView
        android:id="@+id/iv_shadow_artwork"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="36dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_hotfox_line_shadow" />

    <TextView
        android:id="@+id/tv_shadow_note"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hotfox_shadow_note" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_shadow_toggle"
        style="@style/HotFoxCtaPrimary"
        android:layout_width="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/hotfox_shadow_toggle_on" />
</LinearLayout>
