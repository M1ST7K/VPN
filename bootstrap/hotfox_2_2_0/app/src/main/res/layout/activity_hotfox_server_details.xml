<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/include_hf_header" />

    <TextView
        android:id="@+id/tv_server_details_title"
        style="@style/HotFox.ScreenTitleSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hf_page_gutter"
        android:paddingEnd="@dimen/hf_page_gutter"
        android:text="@string/hotfox_server_details" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/hf_page_gutter"
        android:paddingEnd="@dimen/hf_page_gutter"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/img_server_flag"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_flag_nl" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_server_name"
                style="@style/HotFox.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_server_country"
                style="@style/HotFox.RowCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/img_server_health"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/hotfox_status"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_signal_green" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingStart="@dimen/hf_page_gutter"
        android:paddingEnd="@dimen/hf_page_gutter"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_server_status"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_shield_cream" />

                    <TextView
                        style="@style/HotFox.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/hotfox_status" />

                    <TextView
                        android:id="@+id/tv_row_status"
                        style="@style/HotFox.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_chevron_muted" />
                </LinearLayout>

                <include layout="@layout/include_hf_row_hairline" />

                <LinearLayout
                    android:id="@+id/row_server_load"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_signal_cream" />

                    <TextView
                        style="@style/HotFox.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/hotfox_load" />

                    <TextView
                        android:id="@+id/tv_row_load"
                        style="@style/HotFox.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_chevron_muted" />
                </LinearLayout>

                <include layout="@layout/include_hf_row_hairline" />

                <LinearLayout
                    android:id="@+id/row_server_routing"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_routing_cream" />

                    <TextView
                        style="@style/HotFox.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/hotfox_smart_routing_screen" />

                    <TextView
                        android:id="@+id/tv_row_routing"
                        style="@style/HotFox.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_chevron_muted" />
                </LinearLayout>

                <include layout="@layout/include_hf_row_hairline" />

                <LinearLayout
                    android:id="@+id/row_server_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_shield_cream" />

                    <TextView
                        style="@style/HotFox.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/hotfox_shadow_title" />

                    <TextView
                        android:id="@+id/tv_row_shadow"
                        style="@style/HotFox.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_chevron_muted" />
                </LinearLayout>

                <include layout="@layout/include_hf_row_hairline" />

                <LinearLayout
                    android:id="@+id/row_server_auto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_reconnect_cream" />

                    <TextView
                        style="@style/HotFox.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/hotfox_autoselect" />

                    <TextView
                        android:id="@+id/tv_row_auto"
                        style="@style/HotFox.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hf_chevron_muted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hf_info_muted" />

                <TextView
                    style="@style/HotFox.LegalCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/hotfox_server_auto_note" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_select_server"
                style="@style/HotFox.SubpagePrimary"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_height="@dimen/hf_cta_height"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:minWidth="220dp"
                android:contentDescription="@string/hotfox_select_server"
                android:drawableEnd="@drawable/hf_arrow_right_ink"
                android:text="@string/hotfox_select_server" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_hf_bottom_nav" />
</LinearLayout>
