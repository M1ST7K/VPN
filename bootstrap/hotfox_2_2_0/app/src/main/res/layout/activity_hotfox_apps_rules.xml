<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="16dp">

    <include layout="@layout/include_hotfox_sub_header" />

    <TextView
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_apps_rules_title" />

    <TextView
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_apps_rules_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_apps_include"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/hotfox_chip_on"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/hotfox_apps_include"
            android:textColor="@color/hotfox_cta_on_orange"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chip_apps_exclude"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/hotfox_chip_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/hotfox_apps_exclude"
            android:textColor="@color/hotfox_cream"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/hotfox_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hotfox_line_search" />

        <EditText
            android:id="@+id/et_apps_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="@string/hotfox_apps_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/hotfox_cream"
            android:textColorHint="@color/hotfox_cream_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_apps_empty"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_apps_empty"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/hotfox_rows_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/row_apps_custom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_settings" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_apps_custom_rules" />
                <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_apps_custom_rules_hint" />
            </LinearLayout>
            <TextView android:id="@+id/tv_apps_custom_count" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/hotfox_success" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_apps_selected"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_apps" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_apps_selected_row" />
                <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_apps_selected_hint" />
            </LinearLayout>
            <TextView android:id="@+id/tv_apps_selected_count" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_hotfox_line_chevron" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_cta_height"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/btn_apps_open"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="44dp"
            android:text="@string/hotfox_apps_open_list" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="22dp" android:src="@drawable/ic_hotfox_cta_arrow" />
    </FrameLayout>
</LinearLayout>
