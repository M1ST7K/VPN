<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <include layout="@layout/include_hf_header" />

    <TextView
        android:id="@+id/tv_onboarding_title"
        style="@style/HotFox.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_onboarding_connect_title_ui" />

    <TextView
        android:id="@+id/tv_onboarding_body"
        style="@style/HotFox.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/hotfox_onboarding_connect_body_ui" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/img_onboarding_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_fox_bust_transparent" />

        <ImageView
            android:id="@+id/img_onboarding_overlay"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_onboarding_overlay2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginStart="36dp"
            android:layout_marginTop="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_onboarding_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hf_info_muted" />

        <TextView
            android:id="@+id/tv_onboarding_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/hotfox_onboarding_vpn_note"
            android:textColor="@color/hf_asset_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_onboarding_kicker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_onboarding_primary"
        style="@style/HotFox.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:drawableEnd="@drawable/hf_arrow_right_ink"
        android:text="@string/hotfox_already_have_subscription" />

    <Button
        android:id="@+id/btn_onboarding_secondary"
        style="@style/HotFox.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/hotfox_onboarding_buy_access"
        android:visibility="gone" />
</LinearLayout>
