<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tv_https_kicker"
        style="@style/HotFoxTextBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hotfox_onboarding_kicker" />

    <TextView
        android:id="@+id/tv_https_title"
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hotfox_https_title"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tv_https_body"
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_https_body" />

    <EditText
        android:id="@+id/et_https_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/hotfox_input_bg"
        android:hint="@string/hotfox_https_hint"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:minHeight="56dp"
        android:padding="16dp"
        android:singleLine="true"
        android:textColor="@color/hotfox_cream"
        android:textColorHint="@color/hotfox_cream_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_https_paste"
        style="@style/HotFoxCtaSecondary"
        android:layout_width="wrap_content"
        android:layout_gravity="end"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/hotfox_https_paste" />

    <TextView
        android:id="@+id/tv_https_privacy"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_https_privacy" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_https_add"
        style="@style/HotFoxCtaPrimary"
        android:layout_width="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/hotfox_https_add" />
</LinearLayout>
