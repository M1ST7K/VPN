<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TabLayoutTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="HotFoxTextBrand">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_orange</item>
    </style>

    <style name="HotFoxTextDisplay">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_cream</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <style name="HotFoxTextHeadline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_cream</item>
    </style>

    <style name="HotFoxTextBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_cream_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="HotFoxTextLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_cream_muted</item>
    </style>

    <style name="HotFoxTextMeta">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hotfox_cream_muted</item>
    </style>
</resources>
