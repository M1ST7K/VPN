<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="24dp">

    <include layout="@layout/include_hotfox_sub_header" />

    <TextView
        android:id="@+id/tv_autopilot_title"
        style="@style/HotFoxTextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hotfox_autopilot_screen_title" />

    <TextView
        android:id="@+id/tv_autopilot_summary"
        style="@style/HotFoxTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_autopilot_screen_summary" />

    <TextView
        android:id="@+id/tv_autopilot_decision"
        style="@style/HotFoxTextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hotfox_rows_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/btn_autopilot_toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:drawableStart="@drawable/ic_hotfox_line_bolt"
                android:drawablePadding="12dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:textColor="@color/hotfox_cream"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/row_autopilot_wifi"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_wifi" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_autopilot_wifi" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_autopilot_wifi_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_autopilot_wifi_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_autopilot_cellular"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_globe" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_autopilot_cellular" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_autopilot_cellular_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_autopilot_cellular_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_autopilot_trusted"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_lock" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_settings_trusted" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_autopilot_trusted_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_autopilot_trusted_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_autopilot_pause"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_pause" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_settings_pause" />
                    <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_autopilot_pause_hint" />
                </LinearLayout>
                <TextView android:id="@+id/tv_autopilot_pause_value" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_autopilot_protection"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotfox_row_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_shield" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_settings_protection" />
                    <TextView android:id="@+id/tv_autopilot_captive" style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_autopilot_captive_idle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_cta_height"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/btn_autopilot_done"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="44dp"
            android:text="@string/hotfox_autopilot_done" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="22dp" android:src="@drawable/ic_hotfox_cta_arrow" />
    </FrameLayout>
</LinearLayout>
