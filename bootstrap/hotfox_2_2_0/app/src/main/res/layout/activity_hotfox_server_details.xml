<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/hotfox_screen_inset"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_details_kicker"
            style="@style/HotFoxTextBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hotfox_server_details_title" />

        <TextView
            android:id="@+id/tv_details_title"
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_details_country"
            style="@style/HotFoxTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                style="@style/HotFoxTextLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hotfox_server_latency" />

            <TextView
                android:id="@+id/tv_details_latency"
                style="@style/HotFoxTextHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="22sp" />

            <TextView
                style="@style/HotFoxTextLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/hotfox_server_mode" />

            <TextView
                android:id="@+id/tv_details_mode"
                style="@style/HotFoxTextHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_details_note"
            style="@style/HotFoxTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hotfox_server_unavailable_metric" />

        <View
            android:layout_width="1dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/btn_details_select"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_server_select" />
    </LinearLayout>
</ScrollView>
