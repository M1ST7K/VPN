<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_editorial_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tv_autopilot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:text="@string/hotfox_autopilot_screen_title"
        android:textColor="@color/hotfox_editorial_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tv_autopilot_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_autopilot_screen_summary"
        android:textColor="@color/hotfox_editorial_text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_autopilot_decision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/hotfox_editorial_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_autopilot_captive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/hotfox_autopilot_captive_idle"
        android:textColor="@color/hotfox_editorial_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_autopilot_toggle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="@string/hotfox_autopilot_enabled"
        app:backgroundTint="@color/hotfox_orange"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_autopilot_pause"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:text="@string/hotfox_settings_pause"
        android:textColor="@color/hotfox_editorial_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_autopilot_protection"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:text="@string/hotfox_settings_protection"
        android:textColor="@color/hotfox_editorial_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_autopilot_trusted"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:text="@string/hotfox_settings_trusted"
        android:textColor="@color/hotfox_editorial_text" />
</LinearLayout>
