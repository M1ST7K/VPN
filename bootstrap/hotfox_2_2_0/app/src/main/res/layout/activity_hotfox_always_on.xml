<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/hotfox_screen_inset"
        android:paddingBottom="16dp">

        <include layout="@layout/include_hotfox_sub_header" />

        <TextView
            android:id="@+id/tv_always_on_kicker"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_always_on_title"
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hotfox_always_on_heading" />

        <TextView
            android:id="@+id/tv_always_on_body"
            style="@style/HotFoxTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hotfox_always_on_body" />

        <ImageView
            android:id="@+id/iv_always_on_shield"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hotfox_art_always_on_shield" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/hotfox_rows_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                <TextView style="@style/HotFoxTextHeadline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hotfox_always_on_status" />
                <TextView android:id="@+id/tv_always_on_status" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_always_on_not_configured" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                <TextView style="@style/HotFoxTextHeadline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hotfox_always_on_kill_switch" />
                <TextView android:id="@+id/tv_always_on_kill" style="@style/HotFoxTextMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hotfox_always_on_not_configured" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_always_on_help"
            style="@style/HotFoxTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hotfox_always_on_help" />

        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/hotfox_cta_height">
            <TextView
                android:id="@+id/btn_always_on_open"
                style="@style/HotFoxCtaPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="44dp"
                android:text="@string/hotfox_always_on_open" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="22dp" android:src="@drawable/ic_hotfox_cta_arrow" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/include_hotfox_bottom_nav" />
</LinearLayout>
