<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/hotfox_screen_inset"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_routing_title"
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hotfox_smart_routing"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_routing_summary"
            style="@style/HotFoxTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hotfox_routing_screen_summary" />

        <LinearLayout
            android:id="@+id/row_routing_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/hotfox_surface_card"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="72dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_routing_mode"
                style="@style/HotFoxTextHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hotfox_route_smart" />

            <TextView
                android:id="@+id/tv_routing_mode_detail"
                style="@style/HotFoxTextMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hotfox_route_smart_summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_routing_apps"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotfox_row_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp">

            <TextView
                style="@style/HotFoxTextHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hotfox_routing_apps" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_hotfox_line_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_routing_dns"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotfox_row_height"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/tv_routing_dns"
                style="@style/HotFoxTextHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hotfox_routing_dns" />

            <TextView
                android:id="@+id/tv_routing_dns_value"
                style="@style/HotFoxTextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_routing_ipv6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotfox_row_height"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/tv_routing_ipv6"
                style="@style/HotFoxTextHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hotfox_routing_ipv6" />

            <TextView
                android:id="@+id/tv_routing_ipv6_value"
                style="@style/HotFoxTextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_routing_lan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotfox_row_height"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/tv_routing_lan"
                style="@style/HotFoxTextHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hotfox_routing_lan" />

            <TextView
                android:id="@+id/tv_routing_lan_value"
                style="@style/HotFoxTextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_routing_mode"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_smart_routing_title" />

        <TextView
            android:id="@+id/btn_routing_advanced"
            style="@style/HotFoxCtaSecondary"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_routing_advanced" />
    </LinearLayout>
</ScrollView>
