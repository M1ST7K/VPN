<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/hf_page_gutter"
    android:paddingEnd="@dimen/hf_page_gutter">

    <include layout="@layout/include_hf_header" />

    <TextView
        android:id="@+id/tv_https_title"
        style="@style/HotFox.ScreenTitleSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hotfox_https_title" />

    <TextView
        style="@style/HotFox.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_https_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/hf_native_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hf_link_muted" />

        <EditText
            android:id="@+id/et_https_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hotfox_https_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/hf_asset_cream"
            android:textColorHint="@color/hf_asset_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_https_paste"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/hotfox_https_paste"
            android:textColor="@color/hf_asset_orange"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hf_lock_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/hotfox_https_lock_note"
            android:textColor="@color/hf_asset_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_https_add"
        style="@style/HotFox.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        android:layout_height="@dimen/hf_cta_height"
        android:layout_marginTop="16dp"
        android:maxWidth="@dimen/hf_cta_max_width"
        android:drawableEnd="@drawable/hf_arrow_right_ink"
        android:text="@string/hotfox_https_add" />

    <FrameLayout
        android:id="@+id/https_hero_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/hf_hero_bleed"
        android:layout_marginEnd="@dimen/hf_hero_bleed"
        android:layout_marginTop="@dimen/hf_hero_margin_top"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.v2ray.ang.ui.HotfoxHeroView
            android:id="@+id/https_hero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:hfHeroAnimate="false"
            app:hfHeroShowFox="true"
            app:hfHeroShowPlanet="true"
            app:hfHeroVariant="support" />
    </FrameLayout>
</LinearLayout>
