<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <include layout="@layout/include_hf_header" />

    <TextView
        android:id="@+id/tv_autopilot_title"
        style="@style/HotFox.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hotfox_autopilot_screen_title" />

    <TextView
        android:id="@+id/tv_autopilot_summary"
        style="@style/HotFox.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hotfox_autopilot_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_refresh_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_autopilot_screen_title" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/btn_autopilot_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/hf_native_switch_orange"
                android:button="@null"
                android:contentDescription="@string/hotfox_autopilot_screen_title"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_autopilot_trusted"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_wifi_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_new_wifi" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_chevron_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_autopilot_protection"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_signal_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_cellular" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_chevron_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_autopilot_pause"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_pause_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_pause" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_chevron_muted" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_autopilot_decision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/hf_asset_cream"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_autopilot_captive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/hotfox_autopilot_captive_idle"
        android:textColor="@color/hf_asset_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_autopilot_done"
        style="@style/HotFox.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:drawableEnd="@drawable/hf_arrow_right_ink"
        android:text="@string/hotfox_done" />
</LinearLayout>
