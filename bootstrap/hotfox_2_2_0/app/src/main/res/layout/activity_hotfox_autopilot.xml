<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/hotfox_screen_inset"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_autopilot_title"
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hotfox_autopilot_screen_title"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tv_autopilot_summary"
            style="@style/HotFoxTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hotfox_autopilot_screen_summary" />

        <TextView
            android:id="@+id/tv_autopilot_decision"
            style="@style/HotFoxTextHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_autopilot_captive"
            style="@style/HotFoxTextMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hotfox_autopilot_captive_idle" />

        <TextView
            android:id="@+id/btn_autopilot_toggle"
            style="@style/HotFoxCtaPrimary"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_autopilot_enabled" />

        <TextView
            android:id="@+id/btn_autopilot_pause"
            style="@style/HotFoxCtaSecondary"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_settings_pause" />

        <TextView
            android:id="@+id/btn_autopilot_protection"
            style="@style/HotFoxCtaSecondary"
            android:layout_width="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_settings_protection" />

        <TextView
            android:id="@+id/btn_autopilot_trusted"
            style="@style/HotFoxCtaSecondary"
            android:layout_width="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/hotfox_settings_trusted" />
    </LinearLayout>
</ScrollView>
