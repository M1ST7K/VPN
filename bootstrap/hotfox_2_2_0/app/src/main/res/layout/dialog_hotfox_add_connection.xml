<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hotfox_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/hotfox_screen_inset"
    android:paddingTop="18dp"
    android:paddingEnd="@dimen/hotfox_screen_inset"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_add_title"
            style="@style/HotFoxTextDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hotfox_add_connection_title"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/btn_add_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/hotfox_row_ripple"
            android:clickable="true"
            android:contentDescription="@android:string/cancel"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_hotfox_line_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_add_https"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_row_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/hotfox_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_link" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_add_https" />
            <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_add_https_hint" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="@dimen/hotfox_hairline" android:background="@color/hotfox_hairline" />

    <LinearLayout
        android:id="@+id/row_add_clipboard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_row_height"
        android:background="@drawable/hotfox_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_clipboard" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_add_clipboard" />
            <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_add_clipboard_hint" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="@dimen/hotfox_hairline" android:background="@color/hotfox_hairline" />

    <LinearLayout
        android:id="@+id/row_add_qr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_row_height"
        android:background="@drawable/hotfox_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_qr" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_add_qr" />
            <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_add_qr_hint" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="@dimen/hotfox_hairline" android:background="@color/hotfox_hairline" />

    <LinearLayout
        android:id="@+id/row_add_file"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_row_height"
        android:background="@drawable/hotfox_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_file" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_add_file" />
            <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_add_file_hint" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="@dimen/hotfox_hairline" android:background="@color/hotfox_hairline" />

    <LinearLayout
        android:id="@+id/row_add_always_on"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hotfox_row_height"
        android:background="@drawable/hotfox_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hotfox_line_shield" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HotFoxTextHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hotfox_add_always_on" />
            <TextView style="@style/HotFoxTextMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/hotfox_add_always_on_hint" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_hotfox_line_chevron" />
    </LinearLayout>
</LinearLayout>
