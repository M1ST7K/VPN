<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotfox_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/hotfox_screen_inset"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/hotfox_screen_inset">

        <include layout="@layout/include_hotfox_sub_header" />

        <TextView
            style="@style/HotFoxTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hotfox_settings_title" />

        <TextView
            style="@style/HotFoxTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hotfox_settings_body" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/settings_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hotfox_rows_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp" />
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/include_hotfox_bottom_nav" />
</LinearLayout>
