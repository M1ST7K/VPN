<?xml version="1.0" encoding="utf-8"?>
<!-- Static Onest 2.001 instances (SIL OFL 1.1); see docs/HOTFOX_TYPOGRAPHY_ONEST.md.
     textStyle normal resolves to 400 and bold to 700. 500/600 roles reference
     @font/onest_medium and @font/onest_semibold directly so API 24 never synthesizes weights. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/onest_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/onest_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/onest_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/onest_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/onest_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/onest_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/onest_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/onest_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
