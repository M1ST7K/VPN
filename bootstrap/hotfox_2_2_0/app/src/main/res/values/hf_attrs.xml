<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="HotFoxHeroArtwork">
        <attr name="hfHeroVariant" format="enum">
            <enum name="splash" value="0" />
            <enum name="page" value="1" />
            <enum name="support" value="2" />
            <enum name="homeDisconnected" value="3" />
            <enum name="homeConnecting" value="4" />
            <enum name="homeConnected" value="5" />
            <enum name="subscription" value="6" />
            <enum name="subscriptionInput" value="7" />
        </attr>
        <attr name="hfHeroShowFox" format="boolean" />
        <attr name="hfHeroShowPlanet" format="boolean" />
        <attr name="hfHeroAnimate" format="boolean" />
        <attr name="hfHeroClip" format="boolean" />
    </declare-styleable>
</resources>
