<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hf_asset_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <include layout="@layout/include_hf_header" />

    <TextView
        style="@style/HotFox.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hotfox_shadow_title" />

    <TextView
        style="@style/HotFox.BodySecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingEnd="40dp"
        android:text="@string/hotfox_shadow_body" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_native_network_topology" />

        <ImageView
            android:layout_width="112dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hf_shadow_shield" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_shield_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_status" />

            <TextView
                android:id="@+id/tv_shadow_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hf_asset_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hf_settings_cream" />

            <TextView
                style="@style/HotFox.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/hotfox_mode" />

            <TextView
                android:id="@+id/tv_shadow_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hf_asset_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_shadow_keep_auto"
        style="@style/HotFox.SubpagePrimary"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:minWidth="220dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:drawableEnd="@drawable/hf_arrow_right_ink"
        android:text="@string/hotfox_keep_auto" />
</LinearLayout>
